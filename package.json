{
  "name": "evently",
  "version": "1.0.0",
  "description": "Event management platform backend with PostgreSQL and Paystack integration",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "build": "echo 'Backend-only build completed'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --testPathPattern='tests/unit'",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --testPathPattern='tests/integration'",
    "test:smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/smoke --testPathPattern='tests/smoke'",
    "load-test": "k6 run tests/load/load-test.js",
    "docs:generate": "swagger-jsdoc -d swaggerConfig.js src/routes/*.js -o docs/api-spec.json",
    "docs:serve": "swagger-ui-serve docs/api-spec.json"
  },
  "keywords": [
    "event",
    "management",
    "paystack",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.7.5",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0",
    "winston-cloudwatch": "^6.2.0"
  }
}
